<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CV – Matt Hodges</title>
  <meta name="description" content="Web CV for Matt Hodges – Cloud & Infrastructure Engineer specialising in Linux, automation, and monitoring." />
  <link rel="icon" href="/favicon.ico" />
  <link rel="canonical" href="https://matthodges.uk/cv">

  <style>
    /* ====== Design tokens (same system as index) ====== */
    :root{
      --bg: #0b0d11; --bg-elev: #11141a; --text: #e9edf3; --muted: #a8b0bd;
      --brand: #7aa2ff; --accent: #58d1b4; --danger: #ff6b6b;
      --radius: 16px; --shadow: 0 10px 30px rgba(0,0,0,.35); --maxw: 1100px;
    }
    @media (prefers-color-scheme: light){
      :root{ --bg:#fff; --bg-elev:#f7f9fc; --text:#0b0d11; --muted:#5c6470; --shadow: 0 8px 24px rgba(0,0,0,.08);}  
    }

    /* ====== Base ====== */
    *{ box-sizing: border-box; }
    html{ scroll-behavior: smooth; }
    body{
      margin:0; font:16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      color:var(--text); background: radial-gradient(1200px 800px at 10% -10%, rgba(90,120,255,.12), transparent 35%),
              radial-gradient(900px 600px at 120% 10%, rgba(90,220,190,.10), transparent 30%), var(--bg);
    }
    a{ color: inherit; text-underline-offset: .2em; }
    img{ max-width: 100%; height: auto; }
    .container{ max-width: var(--maxw); margin: 0 auto; padding: 0 20px; }

    /* ====== Header / Nav ====== */
    header{ position: sticky; top:0; z-index:50; background: color-mix(in oklab, var(--bg), transparent 10%); backdrop-filter: blur(10px); border-bottom:1px solid color-mix(in oklab, var(--text), transparent 90%); }
    .nav{ display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px 0; }
    .brand{ display:flex; align-items:center; gap:10px; font-weight:600; letter-spacing:.3px; }
    .brand-badge{ width:10px; height:10px; border-radius:50%; background:linear-gradient(135deg, var(--brand), var(--accent)); box-shadow: 0 0 18px color-mix(in oklab, var(--brand), transparent 50%);}    
    nav ul{ display:flex; gap:14px; list-style:none; margin:0; padding:0; }
    nav a{ display:inline-block; padding:8px 12px; border-radius:999px; text-decoration:none; color:var(--muted); border:1px solid transparent; }
    nav a:hover, nav a:focus-visible{ color:var(--text); border-color: color-mix(in oklab, var(--text), transparent 85%); background: color-mix(in oklab, var(--bg-elev), transparent 15%); outline:none; }

    /* ====== Common UI ====== */
    .hero{ padding: 48px 0 24px; }
    h1{ font-size: clamp(26px, 5vw, 40px); margin:0 0 6px; }
    .eyebrow{ display:inline-flex; align-items:center; gap:8px; font-size:14px; color:var(--muted); background: color-mix(in oklab, var(--bg-elev), transparent 20%); padding:6px 10px; border-radius:999px; border:1px solid color-mix(in oklab, var(--text), transparent 88%); }
    .lede{ font-size: clamp(16px, 2.2vw, 20px); color:var(--muted); max-width:60ch; margin:8px 0 16px; }

    .btn{ display:inline-flex; align-items:center; gap:10px; padding:10px 16px; border-radius:999px; border:1px solid color-mix(in oklab, var(--text), transparent 85%); background: linear-gradient(180deg, color-mix(in oklab, var(--bg-elev), transparent 10%), color-mix(in oklab, var(--bg), transparent 0%)); text-decoration:none; }
    .btn.primary{ background:linear-gradient(135deg, var(--brand), var(--accent)); color:#081018; border:none; box-shadow:var(--shadow); }
    .btn:hover, .btn:focus-visible{ transform: translateY(-1px); box-shadow: 0 12px 28px rgba(0,0,0,.2); outline:none; }

    section{ padding: 28px 0; }
    .grid{ display:grid; grid-template-columns: repeat(12, 1fr); gap:18px; }
    .card{ grid-column: span 12; background: color-mix(in oklab, var(--bg-elev), transparent 0%); border:1px solid color-mix(in oklab, var(--text), transparent 90%); border-radius: var(--radius); padding:18px; box-shadow: var(--shadow); }
    @media (min-width: 720px){ .xs-6{ grid-column: span 6; } }
    @media (min-width: 1024px){ .md-4{ grid-column: span 4; } }

    .two-col{ display:grid; gap:18px; }
    @media (min-width: 900px){ .two-col{ grid-template-columns: 2fr 1fr; } }

    .list-plain{ margin:0; padding-left: 1em; }
    .list-plain li{ margin: 6px 0; }

    .pill{ display:inline-block; padding:6px 10px; border-radius:999px; border:1px solid color-mix(in oklab, var(--text), transparent 85%); color:var(--muted); margin: 4px 6px 0 0; }

    footer{ margin-top: 40px; padding: 32px 0 60px; border-top: 1px solid color-mix(in oklab, var(--text), transparent 90%); color: var(--muted); }
    .footer-grid{ display:grid; gap: 14px; }
    @media (min-width:720px){ .footer-grid{ grid-template-columns: 1fr auto; align-items:center; } }
    /* --- Mobile overflow fixes --- */
html, body { overflow-x: hidden; }                     /* prevents sideways scroll */
.grid { grid-template-columns: repeat(12, minmax(0,1fr)); } /* let grid columns shrink */
nav ul { flex-wrap: wrap; }                            /* allow nav items to wrap to a new line */
nav a { white-space: nowrap; }                         /* keep individual links tidy */
@media (max-width: 720px){
  nav ul { gap: 8px; }                                 /* smaller gaps on small screens */
  .btn { padding: 8px 12px; }                          /* slightly smaller buttons */
  .brand { font-size: 15px; }                          /* keep header compact */
}
  </style>
</head>
<body>
  <header>
    <div class="container nav" role="navigation" aria-label="Primary">
      <div class="brand"><span class="brand-badge" aria-hidden="true"></span> Matt Hodges</div>
      <nav>
        <ul>
          <li><a href="/index.html">Home</a></li>
          <li><a href="/projects.html">Projects</a></li>
          <li><a aria-current="page">CV</a></li>
          <li><a href="/index.html#contact">Contact</a></li>
          <li><a class="btn" href="/files/Matt_Hodges_CV.pdf" rel="noopener" target="_blank">Download PDF</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="container">
    <section class="hero" aria-labelledby="cv-title">
      <p class="eyebrow">Linux • Automation • Monitoring • Hosting</p>
      <h1 id="cv-title">Cloud & Infrastructure Engineer</h1>
      <p class="lede">I specialise in making hosting platforms reliable and maintainable—reducing manual toil with automation and improving incident clarity with effective monitoring.</p>
      <div class="cta-row">
        <a class="btn primary" href="/files/Matt_Hodges_CV.pdf" rel="noopener" target="_blank">Download CV (PDF)</a>
        <a class="btn" href="mailto:contact@matthodges.uk">Contact</a>
      </div>
    </section>

    <section class="two-col">
      <!-- LEFT: main content -->
      <article class="card">
        <h2>Summary</h2>
        <p>Cloud & Infrastructure Engineer with 5+ years supporting VPS and bare metal customers. Focused on Linux systems, automation (Ansible, Bash), monitoring (Zabbix), and pragmatic migrations (including cPanel). Calm under pressure, thorough with documentation, and collaborative across teams.</p>

        <h2>Experience</h2>
        <h3>Hosting Support / Cloud Services Engineer</h3>
        <p><em>2019 – Present</em></p>
        <ul class="list-plain">
          <li>Deliver L3 support across Linux servers (Rocky, Alma, Ubuntu, Debian) and cPanel environments.</li>
          <li>Automate repeatable tasks with Ansible and Bash to reduce manual effort and error rates.</li>
          <li>Implement and tune Zabbix monitoring; improve signal-to-noise during incidents.</li>
          <li>Handle migrations and cutovers with clear runbooks and minimal downtime.</li>
          <li>Work closely with engineers and stakeholders; document solutions teams can own.</li>
        </ul>

        <h2>Selected Projects</h2>
        <ul class="list-plain">
          <li><strong>Pingdom to Zabbix</strong> – Unifies external uptime checks with internal telemetry. <a href="/projects/pingdom-zabbix.html">Details</a></li>
          <li><strong>iptables-management-script</strong> – Safer firewall updates with backups and quick rollback. <a href="/projects/iptables.html">Details</a></li>
          <li><strong>ip-lookup</strong> – Fast CLI lookups for IP geo/DNS data. <a href="/projects/ip-lookup.html">Details</a></li>
          <li><strong>cPanel Migration Tool</strong> – Clear logging and low-downtime account transfers. <a href="/projects/cpanel-migration.html">Details</a></li>
        </ul>

        <h2>Education & Certifications</h2>
        <ul class="list-plain">
          <li>Actively studying towards RHCSA/RHCE (self-directed; labs and Udemy courses).</li>
        </ul>

        <h2>Community & Interests</h2>
        <ul class="list-plain">
          <li>Writing practical notes on Linux hosting, Zabbix, and automation.</li>
          <li>Building tooling for faster triage and fewer production surprises.</li>
        </ul>
      </article>

      <!-- RIGHT: skills & contact -->
      <aside class="card">
        <h2>Skills</h2>
        <p>
          <span class="pill">Linux (Rocky/Alma/Ubuntu/Debian)</span>
          <span class="pill">Ansible</span>
          <span class="pill">Bash</span>
          <span class="pill">Zabbix</span>
          <span class="pill">cPanel/WHM</span>
          <span class="pill">Networking & Firewalls</span>
          <span class="pill">DNS & SSL</span>
        </p>

        <h2>Contact</h2>
        <p><a href="mailto:contact@matthodges.uk">contact@matthodges.uk</a></p>
        <p><a href="https://github.com/NexteraMatt" target="_blank" rel="noopener">github.com/NexteraMatt</a></p>
        <p><a href="https://www.linkedin.com/in/matt-hodges-7b0642192/" target="_blank" rel="noopener">linkedin.com/in/matt-hodges-7b0642192</a></p>

        <h2>Links</h2>
        <p><a class="btn" href="/index.html">Back to Home</a></p>
        <p><a class="btn" href="/projects.html">View All Projects</a></p>
      </aside>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <div>© <span id="year"></span> Matt Hodges • <a href="https://github.com/NexteraMatt" rel="me noopener" target="_blank">GitHub</a> • <a href="https://www.linkedin.com/in/matt-hodges-7b0642192/" rel="me noopener" target="_blank">LinkedIn</a></div>
      <div>Last updated: <time datetime="2025-09-23">23 Sep 2025</time></div>
    </div>
  </footer>

  <script>document.getElementById('year').textContent = new Date().getFullYear();</script>
</body>
</html>